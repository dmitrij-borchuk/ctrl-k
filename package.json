{
  "name": "vanilla-k",
  "version": "0.1.0",
  "description": "Zero-dependency, modern command palette library for web applications with Ctrl+K shortcut.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/vanilla-k.min.js",
  "jsdelivr": "./dist/vanilla-k.min.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./vanilla-k.css": "./dist/vanilla-k.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite demo",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run test && npm run build",
    "publish:npm": "npm publish --access public",
    "release": "npm publish --access public"
  },
  "keywords": [
    "vanilla-k",
    "ctrl-k",
    "cmd-k",
    "command-palette",
    "shortcut",
    "hotkey",
    "spotlight",
    "search-dialog",
    "vanilla-js"
  ],
  "author": "Dmytro Borchuk",
  "license": "MIT",
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vite-plugin-dts": "^4.5.3",
    "vitest": "^3.0.7"
  }
}